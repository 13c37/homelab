diff --git a/src/lain/alt.ts b/src/lain/alt.ts
new file mode 100644
index 00000000..90465f66
--- /dev/null
+++ b/src/lain/alt.ts
@@ -0,0 +1,101 @@
+// lain: when a link can't be played (soundcloud's new streams, dead pages, ...),
+// read what the page says it is and rank youtube versions by length.
+// pure functions, no discord.js import, so they can be tested on their own.
+
+export interface PageMeta {
+	title: string;
+	artist?: string;
+	duration?: number; // ms
+}
+
+export interface Candidate {
+	title: string;
+	author: string;
+	duration: number; // ms
+	uri: string;
+	isStream?: boolean;
+	identifier?: string;
+}
+
+/** a duration counts as the same version within this many ms. */
+export const SAME_LENGTH_MS = 3000;
+
+export const isUrl = (q: string): boolean => /^https?:\/\/\S+$/i.test(q.trim());
+
+const decode = (s: string): string =>
+	s
+		.replace(/&#x([0-9a-f]+);/gi, (_, h) => String.fromCodePoint(Number.parseInt(h, 16)))
+		.replace(/&#(\d+);/g, (_, d) => String.fromCodePoint(Number(d)))
+		.replace(/&quot;/g, '"')
+		.replace(/&apos;/g, "'")
+		.replace(/&lt;/g, "<")
+		.replace(/&gt;/g, ">")
+		.replace(/&amp;/g, "&")
+		.trim();
+
+const meta = (html: string, name: string): string | undefined => {
+	const re = new RegExp(
+		`<meta[^>]+(?:property|name|itemprop)=["']${name}["'][^>]*content=["']([^"']*)["']`,
+		"i",
+	);
+	const m = html.match(re);
+	return m ? decode(m[1]) : undefined;
+};
+
+/** iso 8601 duration (PT01H07M52S) to ms. */
+export function isoDuration(iso: string): number | undefined {
+	const m = iso.match(/^P(?:\d+D)?T?(?:(\d+)H)?(?:(\d+)M)?(?:(\d+(?:\.\d+)?)S)?$/i);
+	if (!m || (!m[1] && !m[2] && !m[3])) return undefined;
+	return Math.round(((+(m[1] ?? 0) * 60 + +(m[2] ?? 0)) * 60 + +(m[3] ?? 0)) * 1000);
+}
+
+/** title, artist and length of a track page (soundcloud, bandcamp, anything with og tags). */
+export function parsePage(html: string): PageMeta | undefined {
+	const pageTitle = html.match(/<title[^>]*>([^<]*)<\/title>/i)?.[1];
+	let title = meta(html, "og:title") ?? (pageTitle ? decode(pageTitle) : undefined);
+	let artist: string | undefined;
+
+	// soundcloud: "Stream My Catharsis by Jason.Creer | Listen online for free on SoundCloud"
+	const sc = pageTitle && decode(pageTitle).match(/^(?:Stream )?(.+) by (.+?) \| .*SoundCloud/i);
+	if (sc) {
+		title = sc[1];
+		artist = sc[2];
+	}
+	artist ??= meta(html, "music:musician_description") ?? meta(html, "og:audio:artist");
+	if (!title) return undefined;
+
+	let duration: number | undefined;
+	const iso = meta(html, "duration");
+	if (iso) duration = isoDuration(iso);
+	if (!duration) {
+		const ms = html.match(/"full_duration":(\d+)/) ?? html.match(/"duration":(\d+)/);
+		if (ms) duration = Number(ms[1]);
+	}
+	return { title, artist, duration: duration || undefined };
+}
+
+/** what to search youtube for. */
+export function searchText(m: PageMeta): string {
+	const artist = m.artist?.replace(/[._]+/g, " ").trim();
+	if (artist && !m.title.toLowerCase().includes(artist.toLowerCase())) return `${artist} ${m.title}`;
+	return m.title;
+}
+
+export const sameLength = (a?: number, b?: number): boolean =>
+	!!a && !!b && Math.abs(a - b) <= SAME_LENGTH_MS;
+
+/** top `n` unique non-stream candidates; same-length ones first, otherwise search order. */
+export function rank<T extends Candidate>(lists: T[][], target?: number, n = 3): T[] {
+	const seen = new Set<string>();
+	const all: T[] = [];
+	for (const list of lists)
+		for (const c of list) {
+			const key = c.identifier ?? c.uri;
+			if (c.isStream || seen.has(key)) continue;
+			seen.add(key);
+			all.push(c);
+		}
+	const match = all.filter((c) => sameLength(c.duration, target));
+	const rest = all.filter((c) => !sameLength(c.duration, target));
+	return [...match, ...rest].slice(0, n);
+}
diff --git a/src/lain/fallback.ts b/src/lain/fallback.ts
new file mode 100644
index 00000000..792d6b83
--- /dev/null
+++ b/src/lain/fallback.ts
@@ -0,0 +1,130 @@
+// lain: plain-text searches go to youtube music first; links that fail get
+// up to three youtube versions to pick from, compared by length.
+import { ActionRowBuilder, ButtonBuilder, ButtonStyle } from "discord.js";
+import type { Player, SearchResult, Track } from "lavalink-client";
+import type { Context } from "../structures/index";
+import { applyFairPlayToQueue } from "../utils/functions/player";
+import { isUrl, type PageMeta, parsePage, rank, sameLength, searchText } from "./alt";
+import { keepComponents } from "./text";
+
+const PICK_MS = 60_000;
+const PAGE_MS = 5_000;
+
+const found = (r?: SearchResult | null): r is SearchResult =>
+	!!r && r.loadType !== "error" && r.loadType !== "empty" && (r.tracks?.length ?? 0) > 0;
+
+async function tryFind(player: Player, query: string, source: string | undefined, requester: unknown) {
+	try {
+		const r = (await player.search(
+			source ? { query, source: source as any } : { query },
+			requester,
+		)) as SearchResult;
+		return found(r) ? r : undefined;
+	} catch {
+		return undefined;
+	}
+}
+
+/** links as they are; words on youtube music first, then youtube. */
+export async function lainSearch(
+	player: Player,
+	query: string,
+	requester: unknown,
+): Promise<SearchResult | undefined> {
+	if (isUrl(query)) return tryFind(player, query, undefined, requester);
+	return (
+		(await tryFind(player, query, "ytmsearch", requester)) ??
+		(await tryFind(player, query, "ytsearch", requester))
+	);
+}
+
+async function readPage(url: string): Promise<PageMeta | undefined> {
+	try {
+		const res = await fetch(url, {
+			headers: { "user-agent": "Mozilla/5.0 (X11; Linux x86_64) lain", "accept-language": "en" },
+			redirect: "follow",
+			signal: AbortSignal.timeout(PAGE_MS),
+		});
+		if (!res.ok) return undefined;
+		return parsePage((await res.text()).slice(0, 2_000_000));
+	} catch {
+		return undefined;
+	}
+}
+
+const asCandidate = (t: Track) => ({
+	title: t.info.title,
+	author: t.info.author,
+	duration: t.info.duration,
+	uri: t.info.uri ?? "",
+	isStream: t.info.isStream,
+	identifier: t.info.identifier,
+	track: t,
+});
+
+/**
+ * the link in `query` didn't play: offer youtube versions with buttons.
+ * returns false when there is nothing to offer (caller shows the usual error).
+ */
+export async function offerAlternatives(ctx: Context, player: Player, query: string): Promise<boolean> {
+	if (!isUrl(query) || !ctx.msg) return false;
+	const page = await readPage(query.trim());
+	if (!page) return false;
+
+	const text = searchText(page);
+	const [ytm, yt] = await Promise.all([
+		tryFind(player, text, "ytmsearch", ctx.author),
+		tryFind(player, text, "ytsearch", ctx.author),
+	]);
+	const picks = rank([ytm?.tracks ?? [], yt?.tracks ?? []].map((l) => l.map(asCandidate)), page.duration);
+	if (picks.length === 0) return false;
+
+	const time = (ms: number) => ctx.client.utils.formatTime(ms);
+	const lines = [
+		`couldn't play that link. it says: ${page.title}${page.artist ? ` by ${page.artist}` : ""}${page.duration ? ` (${time(page.duration)})` : ""}`,
+		"found these:",
+		...picks.map(
+			(c, i) =>
+				`${i + 1}. [${c.title}](${c.uri}) by ${c.author} · ${time(c.duration)}${sameLength(c.duration, page.duration) ? " ✓ same length" : ""}`,
+		),
+	];
+	if (page.duration && !picks.some((c) => sameLength(c.duration, page.duration)))
+		lines.push("none match the original length.");
+	lines.push("play one?");
+
+	const row = new ActionRowBuilder<ButtonBuilder>().addComponents(
+		...picks.map((_, i) =>
+			new ButtonBuilder().setCustomId(`lain-alt-${i}`).setLabel(String(i + 1)).setStyle(ButtonStyle.Secondary),
+		),
+		new ButtonBuilder().setCustomId("lain-alt-no").setLabel("no").setStyle(ButtonStyle.Secondary),
+	);
+	const msg = await ctx.editMessage({ content: lines.join("\n"), embeds: [], components: keepComponents([row]) });
+	if (!msg) return false;
+
+	const collector = msg.createMessageComponentCollector({
+		filter: (i: any) => i.user.id === ctx.author?.id && String(i.customId).startsWith("lain-alt-"),
+		time: PICK_MS,
+		max: 1,
+	});
+
+	collector.on("collect", async (i: any) => {
+		await i.deferUpdate().catch(() => {});
+		const pick = picks[Number(String(i.customId).slice("lain-alt-".length))];
+		if (!pick) {
+			await ctx.editMessage({ content: "okay. nothing added.", components: [] }).catch(() => {});
+			return;
+		}
+		await player.queue.add(pick.track);
+		if (player.get<boolean>("fairplay")) await applyFairPlayToQueue(player);
+		await ctx
+			.editMessage({ content: `added [${pick.title}](${pick.uri}) to the queue.`, components: [] })
+			.catch(() => {});
+		if (!player.playing && player.queue.tracks.length > 0) await player.play({ paused: false });
+	});
+
+	collector.on("end", async (collected) => {
+		if (collected.size === 0)
+			await ctx.editMessage({ content: "never mind then.", components: [] }).catch(() => {});
+	});
+	return true;
+}

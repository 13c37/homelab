+/**
+ * lain: stats tests (tables, recorder, queries, format). run from the project root:
+ *
+ *   bun test tests/stats.test.ts
+ */
+import { afterAll, beforeAll, describe, expect, setDefaultTimeout, test } from "bun:test";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { sql } from "drizzle-orm";
+import { eq } from "drizzle-orm";
+import { type Connection, connect } from "../src/database/connection";
+import { play, voiceSession } from "../src/database/schemas";
+import { recorderFor } from "../src/lain/stats/recorder";
+import { formatDuration, songLink } from "../src/lain/stats/format";
+import { overview, parseRange, personal, top } from "../src/lain/stats/queries";
+import { isSkipped, playedMs } from "../src/lain/stats/rules";
+
+setDefaultTimeout(30_000);
+
+let tmpDir: string;
+let conn: Connection;
+let db: any;
+
+beforeAll(async () => {
+	tmpDir = await mkdtemp(join(tmpdir(), "lain-stats-test-"));
+	conn = await connect(join(tmpDir, "pgdata"));
+	await conn.migrate();
+	db = conn.db;
+});
+
+afterAll(async () => {
+	await conn?.close().catch(() => {});
+	await rm(tmpDir, { recursive: true, force: true }).catch(() => {});
+});
+
+describe("tables", () => {
+	test("pglite has the stats tables", async () => {
+		const rows = (
+			await db.execute(
+				sql`select table_name as name from information_schema.tables where table_schema = 'public'`,
+			)
+		).rows as { name: string }[];
+		const names = rows.map((r) => r.name);
+		expect(names).toContain("Play");
+		expect(names).toContain("VoiceSession");
+	});
+});
+
+
+const T0 = Date.parse("2026-11-01T12:00:00Z");
+const at = (ms: number) => new Date(T0 + ms);
+const track = (title: string, duration = 200_000, isStream = false) =>
+	({
+		info: { title, author: "artist", uri: `u:${title}`, sourceName: "youtube", duration, isStream },
+		requester: { id: "u1", username: "u1" },
+	}) as any;
+const plays = async (guildId: string) =>
+	(await db.select().from(play).where(eq(play.guildId, guildId))).sort(
+		(a: any, b: any) => a.startedAt.getTime() - b.startedAt.getTime(),
+	);
+const sessions = async (guildId: string) => db.select().from(voiceSession).where(eq(voiceSession.guildId, guildId));
+
+describe("rules", () => {
+	test("playedMs subtracts pauses, caps at length, never caps streams", () => {
+		expect(playedMs(0, 60_000, 10_000, 200_000, false)).toBe(50_000);
+		expect(playedMs(0, 300_000, 0, 200_000, false)).toBe(200_000);
+		expect(playedMs(0, 900_000, 0, 0, true)).toBe(900_000);
+		expect(playedMs(0, 1_000, 5_000, 200_000, false)).toBe(0);
+	});
+
+	test("isSkipped: replaced/stopped early is a skip, near the end is not", () => {
+		expect(isSkipped("replaced", 40_000, 200_000, false)).toBe(true);
+		expect(isSkipped("replaced", 198_000, 200_000, false)).toBe(false);
+		expect(isSkipped("finished", 10_000, 200_000, false)).toBe(false);
+		expect(isSkipped("stopped", 600_000, 0, true)).toBe(true);
+		expect(isSkipped("restart", 1_000, 200_000, false)).toBe(false);
+	});
+});
+
+describe("recorder", () => {
+	test("pause time is excluded and an early replace is a skip", async () => {
+		const r = recorderFor(db);
+		await r.trackStarted("g1", track("a"), at(0));
+		await r.paused("g1", at(20_000));
+		await r.resumed("g1", at(30_000));
+		await r.trackEnded("g1", "replaced", at(60_000));
+		const [row] = await plays("g1");
+		expect(row.playedMs).toBe(50_000);
+		expect(row.skipped).toBe(true);
+		expect(row.endReason).toBe("replaced");
+		expect(row.requesterId).toBe("u1");
+	});
+
+	test("starting b without an end closes a", async () => {
+		const r = recorderFor(db);
+		await r.trackStarted("g2", track("a"), at(0));
+		await r.trackStarted("g2", track("b"), at(30_000));
+		const [a, b] = await plays("g2");
+		expect(a.playedMs).toBe(30_000);
+		expect(a.endReason).toBe("replaced");
+		expect(b.playedMs).toBeNull();
+	});
+
+	test("left() closes the open track and the session", async () => {
+		const r = recorderFor(db);
+		await r.joined("g3", "c1", at(0));
+		await r.trackStarted("g3", track("a"), at(1_000));
+		await r.left("g3", at(61_000));
+		const [a] = await plays("g3");
+		expect(a.playedMs).toBe(60_000);
+		expect(a.endReason).toBe("destroy");
+		expect(a.skipped).toBe(false);
+		const [s] = await sessions("g3");
+		expect(s.leftAt?.getTime()).toBe(T0 + 61_000);
+	});
+
+	test("closeStale() closes rows a restart left open", async () => {
+		const r = recorderFor(db);
+		await r.joined("g4", "c1", at(-1_000));
+		await r.trackStarted("g4", track("a"), at(0));
+		await r.trackStarted("g4", track("b"), at(90_000));
+		// simulate a crash: reopen a, keep b open, forget the in-memory state
+		await db.update(play).set({ playedMs: null, endReason: null }).where(eq(play.guildId, "g4"));
+		await recorderFor(db).closeStale();
+		const [a, b] = await plays("g4");
+		expect(a.playedMs).toBe(90_000);
+		expect(b.playedMs).toBe(200_000);
+		expect(a.endReason).toBe("restart");
+		expect(b.endReason).toBe("restart");
+		expect(a.skipped || b.skipped).toBe(false);
+		const [s] = await sessions("g4");
+		expect(s.leftAt?.getTime()).toBe(T0 + 90_000 + 200_000);
+	});
+});
+
+const DAY = 86_400_000;
+const ago = (ms: number) => new Date(Date.now() - ms);
+let seq = 0;
+const row = (guildId: string, title: string, requesterId: string, startedAt: Date, ms: number, extra: any = {}) => ({
+	id: `r${++seq}`,
+	guildId,
+	requesterId,
+	title,
+	author: `artist ${title}`,
+	uri: `u:${title}`,
+	lengthMs: 200_000,
+	startedAt,
+	playedMs: ms,
+	endReason: "finished",
+	...extra,
+});
+
+describe("queries", () => {
+	beforeAll(async () => {
+		await db.insert(play).values([
+			row("q1", "A", "u1", ago(DAY), 200_000),
+			row("q1", "A", "u1", ago(DAY - 300_000), 200_000),
+			row("q1", "B", "u2", ago(2 * DAY), 100_000, { endReason: "replaced", skipped: false }),
+			row("q1", "B", "u2", ago(2 * DAY - 200_000), 10_000, { endReason: "replaced", skipped: true }),
+			row("q1", "C", "u1", ago(10 * DAY), 200_000),
+			row("q1", "D", "u1", ago(1_000), null, { endReason: null }),
+			row("q2", "late", "u1", new Date("2026-11-27T20:30:00Z"), 200_000),
+		]);
+		await db.insert(voiceSession).values([
+			{ id: "s1", guildId: "q1", channelId: "c", joinedAt: ago(DAY + 3_600_000), leftAt: ago(DAY) },
+		]);
+	});
+
+	test("a 10 s skip counts in playedMs but not in plays; open rows are ignored", async () => {
+		const o = await overview(db, "q1", "all");
+		expect(o.plays).toBe(4);
+		expect(o.playedMs).toBe(710_000);
+		expect(o.joins).toBe(1);
+		expect(o.vcMs).toBe(3_600_000);
+		expect(o.facts.mostSkipped?.label).toBe("B");
+	});
+
+	test("top orders by count, then playedMs", async () => {
+		const songs = await top(db, "q1", "songs", "all");
+		expect(songs.map((s) => s.label)).toEqual(["A", "C", "B"]);
+		expect(songs[0].count).toBe(2);
+		const people = await top(db, "q1", "people", "all");
+		expect(people.map((p) => p.key)).toEqual(["u1", "u2"]);
+	});
+
+	test("week drops a row from 10 days ago", async () => {
+		const o = await overview(db, "q1", "week");
+		expect(o.plays).toBe(3);
+		expect(o.playedMs).toBe(510_000);
+	});
+
+	test("busiest hour is in europe/berlin", async () => {
+		const o = await overview(db, "q2", "all");
+		expect(o.facts.busiestHour).toBe(21);
+		expect(o.facts.firstSong?.title).toBe("late");
+	});
+
+	test("personal stats", async () => {
+		const me = await personal(db, "q1", "u2", "all");
+		expect(me.plays).toBe(1);
+		expect(me.skipRate).toBe(0.5);
+		const none = await personal(db, "q1", "nobody", "all");
+		expect(none.plays).toBe(0);
+		expect(none.skipRate).toBeNull();
+		expect(none.topSongs).toEqual([]);
+		expect(none.topArtists).toEqual([]);
+		expect(none.firstSong).toBeNull();
+	});
+
+	test("parseRange", () => {
+		expect(parseRange(undefined)).toBe("all");
+		expect(parseRange("w")).toBe("week");
+		expect(parseRange("Month")).toBe("month");
+		expect(parseRange("fortnight")).toBeNull();
+	});
+});
+
+describe("format", () => {
+	test("formatDuration", () => {
+		expect(formatDuration(0)).toBe("0m");
+		expect(formatDuration(42 * 60_000)).toBe("42m");
+		expect(formatDuration((3 * 60 + 5) * 60_000)).toBe("3h 5m");
+		expect(formatDuration((2 * 24 + 4) * 3_600_000)).toBe("2d 4h");
+		expect(formatDuration(-5)).toBe("0m");
+	});
+
+	test("songLink links with embeds suppressed, plain title without uri", () => {
+		expect(songLink({ key: "k", label: "a b", uri: "https://x.y/z", count: 1, playedMs: 0 })).toBe("[a b](<https://x.y/z>)");
+		expect(songLink({ key: "k", label: "a b", count: 1, playedMs: 0 })).toBe("a b");
+	});
+});

+import { Command, type Context, type Lavamusic } from "../../structures/index";
+import { link, queueAgain } from "../../lain/again";
+import { ReadMessageHistory, SendMessages, ViewChannel } from "../../utils/Permissions";
+
+// lain: play the song before this one. what's playing now goes next in the queue.
+export default class Back extends Command {
+	constructor(client: Lavamusic) {
+		super(client, {
+			name: "back",
+			description: {
+				content: "play the previous song",
+				examples: ["back"],
+				usage: "back",
+			},
+			category: "music",
+			aliases: ["previous", "prev", "b"],
+			cooldown: 3,
+			args: false,
+			vote: false,
+			player: { voice: true, dj: false, active: false, djPerm: null },
+			permissions: { dev: false, client: [SendMessages, ReadMessageHistory, ViewChannel], user: [] },
+			slashCommand: false,
+			options: [],
+		});
+	}
+
+	public async run(client: Lavamusic, ctx: Context): Promise<any> {
+		const player = client.manager.getPlayer(ctx.guild.id);
+		const prev = player ? await player.queue.shiftPrevious() : null;
+		if (!player || !prev) return await ctx.sendMessage("nothing before this.");
+
+		const current = player.queue.current;
+		if (current) {
+			await player.queue.add(current, 0);
+			await player.play({ clientTrack: prev, paused: false });
+			return await ctx.sendMessage(`back to ${link(prev)}. ${link(current)} is next.`);
+		}
+		await queueAgain(player, prev);
+		return await ctx.sendMessage(`back to ${link(prev)}.`);
+	}
+}

+// lain: stats rules, pure. lengthMs 0 means stream or unknown length: never capped.
+
+/** wall time minus pauses, capped at the track length (unless stream / unknown), never below 0. */
+export function playedMs(startedAt: number, endedAt: number, pausedMs: number, lengthMs: number, isStream: boolean): number {
+	const ms = Math.max(0, Math.round(endedAt - startedAt - pausedMs));
+	return isStream || lengthMs <= 0 ? ms : Math.min(ms, lengthMs);
+}
+
+/** replaced/stopped counts as a skip unless it ended within 3 s of the track's length. */
+export function isSkipped(endReason: string, playedMs: number, lengthMs: number, _isStream: boolean): boolean {
+	if (endReason !== "replaced" && endReason !== "stopped") return false;
+	return !(lengthMs > 0 && playedMs >= lengthMs - 3000);
+}

index 00000000..d2c8ec7c
--- /dev/null
+++ b/src/lain/text.ts
@@ -0,0 +1,90 @@
+// lain: turn embeds and v2 components into one quiet lowercase text message.
+// pure functions, no discord.js import, so they can be tested on their own.
+
+const MAX = 2000;
+const NBSP_NAMES = new Set(["", "\u200b", "\u200e"]);
+
+// pieces of text that must keep their case: code, discord tokens (<@id>, <#id>, <t:..>)
+// and urls. custom emojis are dropped.
+const TOKEN =
+	/(```[\s\S]*?```|`[^`\n]*`|<a?:\w+:\d+>|<[^<>\s]+>|https?:\/\/[^\s<>()]+(?:\([^\s<>()]*\)[^\s<>()]*)*)/g;
+
+export function quiet(text: string): string {
+	return text
+		.split(TOKEN)
+		.map((part, i) => {
+			if (i % 2 === 0) return part.toLowerCase();
+			if (/^<a?:\w+:\d+>$/.test(part)) return "";
+			// bare and masked links get <> so discord shows no preview card
+			if (/^https?:\/\//.test(part)) return `<${part}>`;
+			return part;
+		})
+		.join("")
+		.replace(/[ \t]+\n/g, "\n")
+		.replace(/^[ \t]+|[ \t]+$/g, "")
+		.replace(/\n{3,}/g, "\n\n");
+}
+
+const plain = (x: any): any => (x && typeof x.toJSON === "function" ? x.toJSON() : x);
+
+export function embedText(embed: any): string {
+	const e = plain(embed) ?? {};
+	const lines: string[] = [];
+	if (e.author?.name) lines.push(e.author.name);
+	if (e.title) lines.push(e.url ? `[${e.title}](${e.url})` : e.title);
+	if (e.description) lines.push(e.description);
+	for (const f of e.fields ?? []) {
+		const name = String(f.name ?? "").trim();
+		lines.push(NBSP_NAMES.has(name) ? f.value : `${name}: ${f.value}`);
+	}
+	if (e.footer?.text) lines.push(`-# ${e.footer.text}`);
+	return lines.filter(Boolean).join("\n");
+}
+
+// components v2: text display (10), section (9), container (17). everything else
+// (buttons, menus, media, separators) is dropped.
+export function componentText(components: any[]): string {
+	const out: string[] = [];
+	const walk = (list: any[]) => {
+		for (const raw of list ?? []) {
+			const c = plain(raw);
+			if (!c) continue;
+			if (c.type === 10 && c.content) out.push(c.content);
+			else if (c.type === 9 || c.type === 17) walk(c.components);
+		}
+	};
+	walk(components);
+	return out.join("\n");
+}
+
+// component arrays lain builds on purpose (the link fallback buttons) survive textify.
+const kept = new WeakSet<object>();
+export function keepComponents<T extends object[]>(rows: T): T {
+	kept.add(rows);
+	return rows;
+}
+
+/** returns new message options: text only, lowercase, no embeds, no components (unless kept). */
+export function textify(options: Record<string, any>): Record<string, any> {
+	const touchesBody =
+		options.content != null || options.embeds !== undefined || options.components !== undefined;
+	if (!touchesBody) return options;
+
+	const parts: string[] = [];
+	if (typeof options.content === "string" && options.content) parts.push(options.content);
+	for (const e of options.embeds ?? []) parts.push(embedText(e));
+	parts.push(componentText(options.components ?? []));
+
+	let content = quiet(parts.filter(Boolean).join("\n"));
+	if (content.length > MAX) content = `${content.slice(0, MAX - 1)}…`;
+
+	const out: Record<string, any> = { ...options };
+	if (options.embeds !== undefined) out.embeds = [];
+	if (options.components !== undefined)
+		out.components = kept.has(options.components) ? options.components : [];
+	if (content) out.content = content;
+	else if ((options.embeds?.length || options.components?.length) && !options.files?.length) {
+		out.content = "…"; // discord rejects empty messages
+	}
+	return out;
+}

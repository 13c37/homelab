+import { Command, type Context, type Lavamusic } from "../../structures/index";
+import { link } from "../../lain/again";
+import { ReadMessageHistory, SendMessages, ViewChannel } from "../../utils/Permissions";
+
+const SHOW = 5;
+
+// lain: "what was that song?" now playing plus the last few, with links.
+export default class Last extends Command {
+	constructor(client: Lavamusic) {
+		super(client, {
+			name: "last",
+			description: {
+				content: "show what's playing and the last few songs",
+				examples: ["last"],
+				usage: "last",
+			},
+			category: "music",
+			aliases: ["what", "history", "recent"],
+			cooldown: 3,
+			args: false,
+			vote: false,
+			player: { voice: false, dj: false, active: false, djPerm: null },
+			permissions: { dev: false, client: [SendMessages, ReadMessageHistory, ViewChannel], user: [] },
+			slashCommand: false,
+			options: [],
+		});
+	}
+
+	public async run(client: Lavamusic, ctx: Context): Promise<any> {
+		const player = client.manager.getPlayer(ctx.guild.id);
+		const current = player?.queue.current;
+		const before = (player?.queue.previous ?? []).slice(0, SHOW);
+		if (!current && before.length === 0) return await ctx.sendMessage("nothing played yet.");
+
+		const lines: string[] = [];
+		if (current) lines.push(`now: ${link(current)} · ${current.info.author}`);
+		if (before.length) {
+			lines.push(current ? "before that:" : "last played:");
+			before.forEach((t, i) => lines.push(`${i + 1}. ${link(t)} · ${t.info.author}`));
+		}
+		return await ctx.sendMessage(lines.join("\n"));
+	}
+}

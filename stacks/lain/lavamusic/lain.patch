+++ b/src/commands/info/Top.ts
@@ -0,0 +1,53 @@
+import { displayName, formatDuration, NO_MENTIONS, RANGE_LABEL, songLink } from "../../lain/stats/format";
+import { parseRange, statsDb, top } from "../../lain/stats/queries";
+import { Command, type Context, type Lavamusic } from "../../structures/index";
+import { ReadMessageHistory, SendMessages, ViewChannel } from "../../utils/Permissions";
+
+const KINDS = { songs: "songs", song: "songs", artists: "artists", artist: "artists", people: "people", users: "people" } as const;
+const USAGE = "usage: `top [songs|artists|people] [week|month|year]`";
+
+// lain: leaderboards from the stats.
+export default class Top extends Command {
+	constructor(client: Lavamusic) {
+		super(client, {
+			name: "top",
+			description: {
+				content: "most played songs, artists or people",
+				examples: ["top", "top artists week", "top people"],
+				usage: "top [songs|artists|people] [week|month|year|all]",
+			},
+			category: "info",
+			aliases: ["leaderboard", "lb"],
+			cooldown: 3,
+			args: false,
+			vote: false,
+			player: { voice: false, dj: false, active: false, djPerm: null },
+			permissions: { dev: false, client: [SendMessages, ReadMessageHistory, ViewChannel], user: [] },
+			slashCommand: false,
+			options: [],
+		});
+	}
+
+	public async run(_client: Lavamusic, ctx: Context, args: string[]): Promise<any> {
+		const send = (content: string) => ctx.sendMessage({ content, allowedMentions: NO_MENTIONS });
+		const words = args.map((a) => a.toLowerCase());
+		const kind = KINDS[words[0] as keyof typeof KINDS];
+		if (kind) words.shift();
+		const range = parseRange(words[0]);
+		if (!range || words.length > 1) return await send(USAGE);
+
+		const db = await statsDb();
+		if (!db) return await send("stats need the postgres database.");
+
+		const rows = await top(db, ctx.guild.id, kind ?? "songs", range);
+		if (rows.length === 0) return await send("nothing played yet.");
+		const labels = await Promise.all(
+			rows.map((r) =>
+				(kind ?? "songs") === "songs" ? songLink(r) : kind === "people" ? displayName(ctx.guild, r.key) : r.label,
+			),
+		);
+		const lines = [`top ${kind ?? "songs"} · ${RANGE_LABEL[range]}`];
+		rows.forEach((r, i) => lines.push(`${i + 1}. ${labels[i]} · ${r.count} ${r.count === 1 ? "play" : "plays"} · ${formatDuration(r.playedMs)}`));
+		return await send(lines.join("\n"));
+	}
+}

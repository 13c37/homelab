diff --git a/src/lain/index.ts b/src/lain/index.ts
new file mode 100644
index 00000000..5d7bc796
--- /dev/null
+++ b/src/lain/index.ts
@@ -0,0 +1,21 @@
+// lain: every outgoing message (channel.send, reply, edit, interaction reply/edit/
+// followUp, webhooks) goes through MessagePayload.resolveBody, so one hook makes
+// the whole bot text-only and lowercase.
+import { MessageFlags, MessageFlagsBitField, MessagePayload } from "discord.js";
+import { textify } from "./text";
+
+const resolveBody = MessagePayload.prototype.resolveBody;
+
+MessagePayload.prototype.resolveBody = function (this: MessagePayload) {
+	const self = this as any;
+	const options = textify(self.options ?? {});
+	if (options.flags != null) {
+		const flags = new MessageFlagsBitField(options.flags);
+		if (flags.has(MessageFlags.IsComponentsV2)) {
+			flags.remove(MessageFlags.IsComponentsV2);
+			options.flags = flags.bitfield || undefined;
+		}
+	}
+	self.options = options;
+	return resolveBody.call(this);
+};
diff --git a/src/lain/text.ts b/src/lain/text.ts

@@ -0,0 +1,37 @@
+// lain: "did you mean loop?" for near-miss commands. pure, no discord.js import.
+
+/** optimal string alignment distance (levenshtein + adjacent swaps). */
+export function distance(a: string, b: string): number {
+	const d: number[][] = Array.from({ length: a.length + 1 }, (_, i) => [i, ...Array(b.length).fill(0)]);
+	for (let j = 1; j <= b.length; j++) d[0][j] = j;
+	for (let i = 1; i <= a.length; i++) {
+		for (let j = 1; j <= b.length; j++) {
+			const cost = a[i - 1] === b[j - 1] ? 0 : 1;
+			d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + cost);
+			if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1])
+				d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1);
+		}
+	}
+	return d[a.length][b.length];
+}
+
+/**
+ * the closest known word, or undefined. short words are left alone so normal
+ * chat after the prefix ("lain is cute") doesn't get corrected.
+ */
+export function closest(word: string, known: Iterable<string>): string | undefined {
+	const w = word.toLowerCase();
+	if (w.length < 3 || !/^[a-z]+$/.test(w)) return undefined;
+	const max = w.length <= 4 ? 1 : 2;
+	let best: string | undefined;
+	let bestD = max + 1;
+	for (const k of known) {
+		if (k.length < 3) continue;
+		const dist = distance(w, k);
+		if (dist < bestD) {
+			best = k;
+			bestD = dist;
+		}
+	}
+	return best;
+}

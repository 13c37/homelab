diff --git a/src/commands/info/Stats.ts b/src/commands/info/Stats.ts
new file mode 100644
index 00000000..9d35bcb8
--- /dev/null
+++ b/src/commands/info/Stats.ts
@@ -0,0 +1,75 @@
+import { displayName, formatDuration, NO_MENTIONS, numbered, RANGE_LABEL, songLink, userIdFrom } from "../../lain/stats/format";
+import { overview, parseRange, personal, statsDb } from "../../lain/stats/queries";
+import { Command, type Context, type Lavamusic } from "../../structures/index";
+import { ReadMessageHistory, SendMessages, ViewChannel } from "../../utils/Permissions";
+
+const USAGE = "usage: `stats [week|month|year]` · `stats me [range]` · `stats @user [range]`";
+
+// lain: server stats, or one person's.
+export default class Stats extends Command {
+	constructor(client: Lavamusic) {
+		super(client, {
+			name: "stats",
+			description: {
+				content: "what this server (or you) played",
+				examples: ["stats", "stats week", "stats me", "stats @user month"],
+				usage: "stats [me|@user] [week|month|year|all]",
+			},
+			category: "info",
+			aliases: [],
+			cooldown: 3,
+			args: false,
+			vote: false,
+			player: { voice: false, dj: false, active: false, djPerm: null },
+			permissions: { dev: false, client: [SendMessages, ReadMessageHistory, ViewChannel], user: [] },
+			slashCommand: false,
+			options: [],
+		});
+	}
+
+	public async run(_client: Lavamusic, ctx: Context, args: string[]): Promise<any> {
+		const send = (content: string) => ctx.sendMessage({ content, allowedMentions: NO_MENTIONS });
+		const [first, second, ...rest] = args.map((a) => a.toLowerCase());
+		const userId = first === "me" ? ctx.author!.id : first ? userIdFrom(first) : null;
+		const range = parseRange(userId ? second : first);
+		if (!range || rest.length > 0 || (!userId && second !== undefined)) return await send(USAGE);
+
+		const db = await statsDb();
+		if (!db) return await send("stats need the postgres database.");
+		const guild = ctx.guild;
+
+		if (userId) {
+			const name = await displayName(guild, userId);
+			const p = await personal(db, guild.id, userId, range);
+			if (p.plays === 0) return await send(`${name} hasn't played anything yet.`);
+			const lines = [
+				`stats for ${name} · ${RANGE_LABEL[range]}`,
+				`${p.plays} songs · ${formatDuration(p.playedMs)} played` +
+					(p.skipRate === null ? "" : ` · skips ${Math.round(p.skipRate * 100)}%`),
+			];
+			if (p.topSongs.length) lines.push(`top songs: ${numbered(p.topSongs.map((s) => `${songLink(s)} (${s.count})`))}`);
+			if (p.topArtists.length) lines.push(`top artists: ${numbered(p.topArtists.map((a) => `${a.label} (${a.count})`))}`);
+			if (p.firstSong) lines.push(`first song: ${p.firstSong.title}`);
+			return await send(lines.join("\n"));
+		}
+
+		const o = await overview(db, guild.id, range);
+		if (o.plays === 0) return await send("nothing played yet.");
+		const people = await Promise.all(o.topPeople.map(async (p) => `${await displayName(guild, p.key)} (${p.count})`));
+		const f = o.facts;
+		const facts = [
+			f.mostSkipped && `most skipped: ${f.mostSkipped.label}`,
+			f.longestSessionMs !== null && `longest session ${formatDuration(f.longestSessionMs)}`,
+			f.busiestHour !== null && `busiest hour ${String(f.busiestHour).padStart(2, "0")}:00`,
+			f.firstSong && `first song ${f.firstSong.title}`,
+		].filter(Boolean);
+		const lines = [
+			`lain stats · ${RANGE_LABEL[range]}`,
+			`${o.plays} songs · ${formatDuration(o.playedMs)} played · ${formatDuration(o.vcMs)} in vc · joined ${o.joins} ${o.joins === 1 ? "time" : "times"}`,
+		];
+		if (o.topSongs.length) lines.push(`top songs: ${numbered(o.topSongs.map((s) => `${songLink(s)} (${s.count})`))}`);
+		if (people.length) lines.push(`top people: ${numbered(people)}`);
+		if (facts.length) lines.push(facts.join(" · "));
+		return await send(lines.join("\n"));
+	}
+}

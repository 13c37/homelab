diff --git a/src/lain/again.ts b/src/lain/again.ts
new file mode 100644
index 00000000..56e6d7db
--- /dev/null
+++ b/src/lain/again.ts
@@ -0,0 +1,25 @@
+// lain: play things again. after the queue ends lavalink-client sets queue.current
+// to null and puts the finished track at queue.previous[0]; while a song plays,
+// queue.previous[0] is the one before it.
+import type { Player, Track } from "lavalink-client";
+import { applyFairPlayToQueue } from "../utils/functions/player";
+
+export const link = (t: Track) => `[${t.info.title}](${t.info.uri})`;
+
+/** the song that just finished (only when nothing is playing). */
+export function lastPlayed(player: Player): Track | undefined {
+	if (player.queue.current) return undefined;
+	return player.queue.previous[0] as Track | undefined;
+}
+
+/** add a track and start playing if idle. returns true when it starts right away. */
+export async function queueAgain(player: Player, track: Track): Promise<boolean> {
+	if (!player.connected) await player.connect();
+	await player.queue.add(track);
+	if (player.get<boolean>("fairplay")) await applyFairPlayToQueue(player);
+	if (!player.playing && !player.queue.current) {
+		await player.play({ paused: false });
+		return true;
+	}
+	return false;
+}
diff --git a/src/lain/againButton.ts b/src/lain/againButton.ts
new file mode 100644
index 00000000..69820ba5
--- /dev/null
+++ b/src/lain/againButton.ts
@@ -0,0 +1,46 @@
+// lain: when the queue ends, the last "playing: …" line gets a ↻ button that plays
+// that song again. only people in the bot's voice channel can press it.
+import { ActionRowBuilder, ButtonBuilder, ButtonStyle, type Message, MessageFlags } from "discord.js";
+import type { Player, Track } from "lavalink-client";
+import type { Lavamusic } from "../structures/index";
+import { lastPlayed, link, queueAgain } from "./again";
+import { keepComponents } from "./text";
+
+const WAIT_MS = 15 * 60_000;
+const ID = "lain-again";
+
+export async function offerAgain(client: Lavamusic, player: Player, message: Message, ended?: Track | null): Promise<void> {
+	const track = lastPlayed(player) ?? ended ?? undefined;
+	const content = message.content;
+	if (!track) {
+		await message.edit({ content, components: [] }).catch(() => {});
+		return;
+	}
+	const row = new ActionRowBuilder<ButtonBuilder>().addComponents(
+		new ButtonBuilder().setCustomId(ID).setLabel("↻ again").setStyle(ButtonStyle.Secondary),
+	);
+	const sent = await message.edit({ content, components: keepComponents([row]) }).catch(() => null);
+	if (!sent) return;
+
+	const collector = sent.createMessageComponentCollector({
+		filter: (i: any) => i.customId === ID,
+		time: WAIT_MS,
+	});
+	collector.on("collect", async (i: any) => {
+		const now = client.manager.getPlayer(player.guildId);
+		const voice = i.member?.voice?.channelId;
+		if (!now || !voice || voice !== now.voiceChannelId) {
+			await i.reply({ content: "join my voice channel first.", flags: MessageFlags.Ephemeral }).catch(() => {});
+			return;
+		}
+		await i.deferUpdate().catch(() => {});
+		collector.stop("used");
+		const started = await queueAgain(now, track);
+		await i
+			.followUp({ content: `${i.user.username}: ${started ? "again" : "queued again"}: ${link(track)}.` })
+			.catch(() => {});
+	});
+	collector.on("end", async () => {
+		await sent.edit({ content, components: [] }).catch(() => {});
+	});
+}
diff --git a/src/lain/alt.ts b/src/lain/alt.ts
new file mode 100644
index 00000000..90465f66
--- /dev/null
+++ b/src/lain/alt.ts
@@ -0,0 +1,101 @@
+// lain: when a link can't be played (soundcloud's new streams, dead pages, ...),
+// read what the page says it is and rank youtube versions by length.
+// pure functions, no discord.js import, so they can be tested on their own.
+
+export interface PageMeta {
+	title: string;
+	artist?: string;
+	duration?: number; // ms
+}
+
+export interface Candidate {
+	title: string;
+	author: string;
+	duration: number; // ms
+	uri: string;
+	isStream?: boolean;
+	identifier?: string;
+}
+
+/** a duration counts as the same version within this many ms. */
+export const SAME_LENGTH_MS = 3000;
+
+export const isUrl = (q: string): boolean => /^https?:\/\/\S+$/i.test(q.trim());
+
+const decode = (s: string): string =>
+	s
+		.replace(/&#x([0-9a-f]+);/gi, (_, h) => String.fromCodePoint(Number.parseInt(h, 16)))
+		.replace(/&#(\d+);/g, (_, d) => String.fromCodePoint(Number(d)))
+		.replace(/&quot;/g, '"')
+		.replace(/&apos;/g, "'")
+		.replace(/&lt;/g, "<")
+		.replace(/&gt;/g, ">")
+		.replace(/&amp;/g, "&")
+		.trim();
+
+const meta = (html: string, name: string): string | undefined => {
+	const re = new RegExp(
+		`<meta[^>]+(?:property|name|itemprop)=["']${name}["'][^>]*content=["']([^"']*)["']`,
+		"i",
+	);
+	const m = html.match(re);
+	return m ? decode(m[1]) : undefined;
+};
+
+/** iso 8601 duration (PT01H07M52S) to ms. */
+export function isoDuration(iso: string): number | undefined {
+	const m = iso.match(/^P(?:\d+D)?T?(?:(\d+)H)?(?:(\d+)M)?(?:(\d+(?:\.\d+)?)S)?$/i);
+	if (!m || (!m[1] && !m[2] && !m[3])) return undefined;
+	return Math.round(((+(m[1] ?? 0) * 60 + +(m[2] ?? 0)) * 60 + +(m[3] ?? 0)) * 1000);
+}
+
+/** title, artist and length of a track page (soundcloud, bandcamp, anything with og tags). */
+export function parsePage(html: string): PageMeta | undefined {
+	const pageTitle = html.match(/<title[^>]*>([^<]*)<\/title>/i)?.[1];
+	let title = meta(html, "og:title") ?? (pageTitle ? decode(pageTitle) : undefined);
+	let artist: string | undefined;
+
+	// soundcloud: "Stream My Catharsis by Jason.Creer | Listen online for free on SoundCloud"
+	const sc = pageTitle && decode(pageTitle).match(/^(?:Stream )?(.+) by (.+?) \| .*SoundCloud/i);
+	if (sc) {
+		title = sc[1];
+		artist = sc[2];
+	}
+	artist ??= meta(html, "music:musician_description") ?? meta(html, "og:audio:artist");
+	if (!title) return undefined;
+
+	let duration: number | undefined;
+	const iso = meta(html, "duration");
+	if (iso) duration = isoDuration(iso);
+	if (!duration) {
+		const ms = html.match(/"full_duration":(\d+)/) ?? html.match(/"duration":(\d+)/);
+		if (ms) duration = Number(ms[1]);
+	}
+	return { title, artist, duration: duration || undefined };
+}
+
+/** what to search youtube for. */
+export function searchText(m: PageMeta): string {
+	const artist = m.artist?.replace(/[._]+/g, " ").trim();
+	if (artist && !m.title.toLowerCase().includes(artist.toLowerCase())) return `${artist} ${m.title}`;
+	return m.title;
+}
+
+export const sameLength = (a?: number, b?: number): boolean =>
+	!!a && !!b && Math.abs(a - b) <= SAME_LENGTH_MS;
+
+/** top `n` unique non-stream candidates; same-length ones first, otherwise search order. */
+export function rank<T extends Candidate>(lists: T[][], target?: number, n = 3): T[] {
+	const seen = new Set<string>();
+	const all: T[] = [];
+	for (const list of lists)
+		for (const c of list) {
+			const key = c.identifier ?? c.uri;
+			if (c.isStream || seen.has(key)) continue;
+			seen.add(key);
+			all.push(c);
+		}
+	const match = all.filter((c) => sameLength(c.duration, target));
+	const rest = all.filter((c) => !sameLength(c.duration, target));
+	return [...match, ...rest].slice(0, n);
+}
diff --git a/src/lain/fallback.ts b/src/lain/fallback.ts
new file mode 100644
index 00000000..792d6b83
--- /dev/null
+++ b/src/lain/fallback.ts
@@ -0,0 +1,130 @@
+// lain: plain-text searches go to youtube music first; links that fail get
+// up to three youtube versions to pick from, compared by length.
+import { ActionRowBuilder, ButtonBuilder, ButtonStyle } from "discord.js";
+import type { Player, SearchResult, Track } from "lavalink-client";
+import type { Context } from "../structures/index";
+import { applyFairPlayToQueue } from "../utils/functions/player";
+import { isUrl, type PageMeta, parsePage, rank, sameLength, searchText } from "./alt";
+import { keepComponents } from "./text";
+
+const PICK_MS = 60_000;
+const PAGE_MS = 5_000;
+
+const found = (r?: SearchResult | null): r is SearchResult =>
+	!!r && r.loadType !== "error" && r.loadType !== "empty" && (r.tracks?.length ?? 0) > 0;
+
+async function tryFind(player: Player, query: string, source: string | undefined, requester: unknown) {
+	try {
+		const r = (await player.search(
+			source ? { query, source: source as any } : { query },
+			requester,
+		)) as SearchResult;
+		return found(r) ? r : undefined;
+	} catch {
+		return undefined;
+	}
+}
+
+/** links as they are; words on youtube music first, then youtube. */
+export async function lainSearch(
+	player: Player,
+	query: string,
+	requester: unknown,
+): Promise<SearchResult | undefined> {
+	if (isUrl(query)) return tryFind(player, query, undefined, requester);
+	return (
+		(await tryFind(player, query, "ytmsearch", requester)) ??
+		(await tryFind(player, query, "ytsearch", requester))
+	);
+}
+
+async function readPage(url: string): Promise<PageMeta | undefined> {
+	try {
+		const res = await fetch(url, {
+			headers: { "user-agent": "Mozilla/5.0 (X11; Linux x86_64) lain", "accept-language": "en" },
+			redirect: "follow",
+			signal: AbortSignal.timeout(PAGE_MS),
+		});
+		if (!res.ok) return undefined;
+		return parsePage((await res.text()).slice(0, 2_000_000));
+	} catch {
+		return undefined;
+	}
+}
+
+const asCandidate = (t: Track) => ({
+	title: t.info.title,
+	author: t.info.author,
+	duration: t.info.duration,
+	uri: t.info.uri ?? "",
+	isStream: t.info.isStream,
+	identifier: t.info.identifier,
+	track: t,
+});
+
+/**
+ * the link in `query` didn't play: offer youtube versions with buttons.
+ * returns false when there is nothing to offer (caller shows the usual error).
+ */
+export async function offerAlternatives(ctx: Context, player: Player, query: string): Promise<boolean> {
+	if (!isUrl(query) || !ctx.msg) return false;
+	const page = await readPage(query.trim());
+	if (!page) return false;
+
+	const text = searchText(page);
+	const [ytm, yt] = await Promise.all([
+		tryFind(player, text, "ytmsearch", ctx.author),
+		tryFind(player, text, "ytsearch", ctx.author),
+	]);
+	const picks = rank([ytm?.tracks ?? [], yt?.tracks ?? []].map((l) => l.map(asCandidate)), page.duration);
+	if (picks.length === 0) return false;
+
+	const time = (ms: number) => ctx.client.utils.formatTime(ms);
+	const lines = [
+		`couldn't play that link. it says: ${page.title}${page.artist ? ` by ${page.artist}` : ""}${page.duration ? ` (${time(page.duration)})` : ""}`,
+		"found these:",
+		...picks.map(
+			(c, i) =>
+				`${i + 1}. [${c.title}](${c.uri}) by ${c.author} · ${time(c.duration)}${sameLength(c.duration, page.duration) ? " ✓ same length" : ""}`,
+		),
+	];
+	if (page.duration && !picks.some((c) => sameLength(c.duration, page.duration)))
+		lines.push("none match the original length.");
+	lines.push("play one?");
+
+	const row = new ActionRowBuilder<ButtonBuilder>().addComponents(
+		...picks.map((_, i) =>
+			new ButtonBuilder().setCustomId(`lain-alt-${i}`).setLabel(String(i + 1)).setStyle(ButtonStyle.Secondary),
+		),
+		new ButtonBuilder().setCustomId("lain-alt-no").setLabel("no").setStyle(ButtonStyle.Secondary),
+	);
+	const msg = await ctx.editMessage({ content: lines.join("\n"), embeds: [], components: keepComponents([row]) });
+	if (!msg) return false;
+
+	const collector = msg.createMessageComponentCollector({
+		filter: (i: any) => i.user.id === ctx.author?.id && String(i.customId).startsWith("lain-alt-"),
+		time: PICK_MS,
+		max: 1,
+	});
+
+	collector.on("collect", async (i: any) => {
+		await i.deferUpdate().catch(() => {});
+		const pick = picks[Number(String(i.customId).slice("lain-alt-".length))];
+		if (!pick) {
+			await ctx.editMessage({ content: "okay. nothing added.", components: [] }).catch(() => {});
+			return;
+		}
+		await player.queue.add(pick.track);
+		if (player.get<boolean>("fairplay")) await applyFairPlayToQueue(player);
+		await ctx
+			.editMessage({ content: `added [${pick.title}](${pick.uri}) to the queue.`, components: [] })
+			.catch(() => {});
+		if (!player.playing && player.queue.tracks.length > 0) await player.play({ paused: false });
+	});
+
+	collector.on("end", async (collected) => {
+		if (collected.size === 0)
+			await ctx.editMessage({ content: "never mind then.", components: [] }).catch(() => {});
+	});
+	return true;
+}
diff --git a/src/lain/index.ts b/src/lain/index.ts
new file mode 100644
index 00000000..5d7bc796
--- /dev/null
+++ b/src/lain/index.ts
@@ -0,0 +1,21 @@
+// lain: every outgoing message (channel.send, reply, edit, interaction reply/edit/
+// followUp, webhooks) goes through MessagePayload.resolveBody, so one hook makes
+// the whole bot text-only and lowercase.
+import { MessageFlags, MessageFlagsBitField, MessagePayload } from "discord.js";
+import { textify } from "./text";
+
+const resolveBody = MessagePayload.prototype.resolveBody;
+
+MessagePayload.prototype.resolveBody = function (this: MessagePayload) {
+	const self = this as any;
+	const options = textify(self.options ?? {});
+	if (options.flags != null) {
+		const flags = new MessageFlagsBitField(options.flags);
+		if (flags.has(MessageFlags.IsComponentsV2)) {
+			flags.remove(MessageFlags.IsComponentsV2);
+			options.flags = flags.bitfield || undefined;
+		}
+	}
+	self.options = options;
+	return resolveBody.call(this);
+};
diff --git a/src/lain/replies.ts b/src/lain/replies.ts
new file mode 100644
index 00000000..2f6b4767
--- /dev/null
+++ b/src/lain/replies.ts
@@ -0,0 +1,49 @@
+// lain: when someone deletes their command message, delete what lain sent for it.
+// MessageCreate runs every command inside track(message); every channel.send (and
+// message.reply, which calls it) made in that async chain is remembered under the
+// command message id. raw MESSAGE_DELETE events then remove those replies
+// (the message cache is 0, so discord.js' own messageDelete never fires).
+import { AsyncLocalStorage } from "node:async_hooks";
+import { BaseGuildTextChannel, BaseGuildVoiceChannel, type Client, ThreadChannel } from "discord.js";
+
+const MAX = 500;
+const store = new AsyncLocalStorage<string>();
+const replies = new Map<string, { channelId: string; ids: string[] }>();
+
+export const track = <T>(messageId: string, fn: () => T): T => store.run(messageId, fn);
+export const untracked = <T>(fn: () => T): T => store.exit(fn);
+
+function remember(commandId: string, channelId: string, replyId: string) {
+	const entry = replies.get(commandId) ?? { channelId, ids: [] };
+	entry.ids.push(replyId);
+	replies.delete(commandId);
+	replies.set(commandId, entry);
+	if (replies.size > MAX) replies.delete(replies.keys().next().value!);
+}
+
+for (const cls of [BaseGuildTextChannel, BaseGuildVoiceChannel, ThreadChannel] as any[]) {
+	const send = cls.prototype.send;
+	if (typeof send !== "function" || send.__lain) continue;
+	const wrapped = async function (this: any, ...args: any[]) {
+		const commandId = store.getStore();
+		const sent = await send.apply(this, args);
+		if (commandId && sent?.id) remember(commandId, sent.channelId, sent.id);
+		return sent;
+	};
+	(wrapped as any).__lain = true;
+	cls.prototype.send = wrapped;
+}
+
+/** call with every raw gateway packet. */
+export function onRaw(client: Client, packet: any) {
+	const ids: string[] =
+		packet?.t === "MESSAGE_DELETE" ? [packet.d.id] : packet?.t === "MESSAGE_DELETE_BULK" ? packet.d.ids : [];
+	for (const id of ids) {
+		const entry = replies.get(id);
+		if (!entry) continue;
+		replies.delete(id);
+		const channel = client.channels.cache.get(entry.channelId) as any;
+		if (!channel?.messages) continue;
+		for (const replyId of entry.ids) channel.messages.delete(replyId).catch(() => {});
+	}
+}
diff --git a/src/lain/stats/format.ts b/src/lain/stats/format.ts
new file mode 100644
index 00000000..02a92f4f
--- /dev/null
+++ b/src/lain/stats/format.ts
@@ -0,0 +1,39 @@
+// lain: text for the stats commands. lowercase, no mentions: people are shown by display name.
+import type { Guild } from "discord.js";
+import type { Range, Ranked } from "./queries";
+
+/** "0m", "42m", "3h 5m", "2d 4h". a zero second unit is dropped ("3h", "2d"). */
+export function formatDuration(ms: number): string {
+	const minutes = Math.floor(Math.max(0, ms) / 60_000);
+	const d = Math.floor(minutes / 1440);
+	const h = Math.floor((minutes % 1440) / 60);
+	const m = minutes % 60;
+	if (d > 0) return h > 0 ? `${d}d ${h}h` : `${d}d`;
+	if (h > 0) return m > 0 ? `${h}h ${m}m` : `${h}h`;
+	return `${m}m`;
+}
+
+/** markdown link like link() in lain/again, with <> so discord adds no embed per song. */
+export const songLink = (r: Ranked) => (r.uri ? `[${r.label}](<${r.uri}>)` : r.label);
+
+export const RANGE_LABEL: Record<Range, string> = {
+	week: "last 7 days",
+	month: "last 30 days",
+	year: "last 365 days",
+	all: "all time",
+};
+
+/** guild display name, or a mention (rendered as a name, never pings with parse: []). */
+export async function displayName(guild: Guild, userId: string): Promise<string> {
+	const member = guild.members.cache.get(userId) ?? (await guild.members.fetch(userId).catch(() => null));
+	return member?.displayName ?? `<@${userId}>`;
+}
+
+export const numbered = (items: string[]) => items.map((s, i) => `${i + 1}. ${s}`).join(" · ");
+
+/** "<@123>", "<@!123>" or a bare id → the id. */
+export function userIdFrom(word: string): string | null {
+	return /^<@!?(\d{15,25})>$/.exec(word)?.[1] ?? (/^\d{15,25}$/.test(word) ? word : null);
+}
+
+export const NO_MENTIONS = { parse: [] } as const;
diff --git a/src/lain/stats/queries.ts b/src/lain/stats/queries.ts
new file mode 100644
index 00000000..9b8cbb24
--- /dev/null
+++ b/src/lain/stats/queries.ts
@@ -0,0 +1,189 @@
+// lain: read side of the stats. only closed rows count; a play counts once it ran 30 s or finished.
+// ranges are rolling windows ending now. hours are europe/berlin.
+import { and, eq, gte, isNotNull, type SQL, sql } from "drizzle-orm";
+import { getDatabase } from "../../database/factory";
+import { PostgresProvider } from "../../database/provider";
+import { play, voiceSession } from "../../database/schemas";
+
+type Db = PostgresProvider["db"];
+export type Range = "week" | "month" | "year" | "all";
+export type Ranked = { key: string; label: string; uri?: string; count: number; playedMs: number };
+export type Facts = {
+	mostSkipped: Ranked | null;
+	longestSessionMs: number | null;
+	busiestHour: number | null;
+	firstSong: { title: string; at: Date } | null;
+};
+export type Overview = {
+	plays: number;
+	playedMs: number;
+	vcMs: number;
+	joins: number;
+	topSongs: Ranked[];
+	topPeople: Ranked[];
+	facts: Facts;
+};
+export type Personal = {
+	plays: number;
+	playedMs: number;
+	skipRate: number | null;
+	topSongs: Ranked[];
+	topArtists: Ranked[];
+	firstSong: { title: string; at: Date } | null;
+};
+
+/** the bot's database when it is postgres, else null (stats are postgres only). */
+export async function statsDb(): Promise<Db | null> {
+	const p = await getDatabase().catch(() => null);
+	return p instanceof PostgresProvider ? p.db : null;
+}
+
+const DAYS: Record<Range, number | null> = { week: 7, month: 30, year: 365, all: null };
+const WORDS: Record<string, Range> = { week: "week", w: "week", month: "month", m: "month", year: "year", y: "year", all: "all" };
+
+/** undefined → "all"; an unknown word → null. */
+export function parseRange(word?: string): Range | null {
+	if (word === undefined) return "all";
+	return WORDS[word.toLowerCase()] ?? null;
+}
+
+const since = (range: Range): Date | null => {
+	const days = DAYS[range];
+	return days === null ? null : new Date(Date.now() - days * 86_400_000);
+};
+
+const num = (s: SQL) => sql<number>`${s}`.mapWith(Number);
+const PLAYED = sql`(${play.playedMs} >= 30000 or ${play.endReason} = 'finished')`;
+const plays = num(sql`count(*) filter (where ${PLAYED})`);
+const playedMs = num(sql`coalesce(sum(${play.playedMs}), 0)`);
+
+const closedIn = (guildId: string, range: Range, userId?: string) => {
+	const from = since(range);
+	return and(
+		eq(play.guildId, guildId),
+		isNotNull(play.playedMs),
+		from ? gte(play.startedAt, from) : undefined,
+		userId === undefined ? undefined : eq(play.requesterId, userId),
+	);
+};
+
+const GROUP = {
+	songs: { key: sql<string>`coalesce(${play.uri}, lower(${play.title}))`, label: sql<string>`max(${play.title})` },
+	artists: { key: sql<string>`lower(${play.author})`, label: sql<string>`max(${play.author})` },
+	people: { key: sql<string>`${play.requesterId}`, label: sql<string>`${play.requesterId}` },
+} as const;
+
+async function ranked(db: Db, where: SQL | undefined, kind: keyof typeof GROUP, limit: number): Promise<Ranked[]> {
+	const g = GROUP[kind];
+	const notNull = kind === "artists" ? isNotNull(play.author) : kind === "people" ? isNotNull(play.requesterId) : undefined;
+	const rows = await db
+		.select({ key: g.key, label: g.label, uri: sql<string | null>`max(${play.uri})`, count: plays, playedMs })
+		.from(play)
+		.where(and(where, notNull))
+		.groupBy(g.key)
+		.having(sql`count(*) filter (where ${PLAYED}) > 0`)
+		.orderBy(sql`4 desc`, sql`5 desc`, sql`2`)
+		.limit(limit);
+	return rows.map((r) => ({
+		key: r.key,
+		label: r.label,
+		...(kind === "songs" && r.uri ? { uri: r.uri } : {}),
+		count: r.count,
+		playedMs: r.playedMs,
+	}));
+}
+
+async function firstSong(db: Db, where: SQL | undefined) {
+	const [row] = await db
+		.select({ title: play.title, at: play.startedAt })
+		.from(play)
+		.where(and(where, PLAYED))
+		.orderBy(play.startedAt)
+		.limit(1);
+	return row ?? null;
+}
+
+export function top(db: Db, guildId: string, kind: "songs" | "artists" | "people", range: Range, limit = 10) {
+	return ranked(db, closedIn(guildId, range), kind, limit);
+}
+
+export async function overview(db: Db, guildId: string, range: Range): Promise<Overview> {
+	const where = closedIn(guildId, range);
+	const from = since(range);
+	const sessionsIn = and(eq(voiceSession.guildId, guildId), from ? gte(voiceSession.joinedAt, from) : undefined);
+	const sessionMs = sql`extract(epoch from coalesce(${voiceSession.leftAt}, now()) - ${voiceSession.joinedAt}) * 1000`;
+
+	const [[totals], [vc], topSongs, topPeople, [skipped], [hour], first] = await Promise.all([
+		db.select({ plays, playedMs }).from(play).where(where),
+		db
+			.select({
+				joins: num(sql`count(*)`),
+				vcMs: num(sql`coalesce(round(sum(${sessionMs})), 0)`),
+				longest: sql<number | null>`round(max(${sessionMs}))`.mapWith((v) => (v === null ? null : Number(v))),
+			})
+			.from(voiceSession)
+			.where(sessionsIn),
+		ranked(db, where, "songs", 3),
+		ranked(db, where, "people", 3),
+		db
+			.select({
+				key: GROUP.songs.key,
+				label: GROUP.songs.label,
+				uri: sql<string | null>`max(${play.uri})`,
+				count: num(sql`count(*)`),
+				playedMs,
+			})
+			.from(play)
+			.where(and(where, eq(play.skipped, true)))
+			.groupBy(GROUP.songs.key)
+			.orderBy(sql`4 desc`, sql`2`)
+			.limit(1),
+		db
+			.select({ hour: num(sql`extract(hour from ${play.startedAt} at time zone 'Europe/Berlin')`) })
+			.from(play)
+			.where(and(where, PLAYED))
+			.groupBy(sql`1`)
+			.orderBy(sql`count(*) desc`, sql`1`)
+			.limit(1),
+		firstSong(db, where),
+	]);
+
+	return {
+		plays: totals?.plays ?? 0,
+		playedMs: totals?.playedMs ?? 0,
+		vcMs: vc?.vcMs ?? 0,
+		joins: vc?.joins ?? 0,
+		topSongs,
+		topPeople,
+		facts: {
+			mostSkipped: skipped
+				? { key: skipped.key, label: skipped.label, ...(skipped.uri ? { uri: skipped.uri } : {}), count: skipped.count, playedMs: skipped.playedMs }
+				: null,
+			longestSessionMs: vc?.longest ?? null,
+			busiestHour: hour?.hour ?? null,
+			firstSong: first,
+		},
+	};
+}
+
+export async function personal(db: Db, guildId: string, userId: string, range: Range): Promise<Personal> {
+	const where = closedIn(guildId, range, userId);
+	const [[totals], topSongs, topArtists, first] = await Promise.all([
+		db
+			.select({ plays, playedMs, closed: num(sql`count(*)`), skips: num(sql`count(*) filter (where ${play.skipped})`) })
+			.from(play)
+			.where(where),
+		ranked(db, where, "songs", 3),
+		ranked(db, where, "artists", 3),
+		firstSong(db, where),
+	]);
+	const closed = totals?.closed ?? 0;
+	return {
+		plays: totals?.plays ?? 0,
+		playedMs: totals?.playedMs ?? 0,
+		skipRate: closed > 0 ? (totals?.skips ?? 0) / closed : null,
+		topSongs,
+		topArtists,
+		firstSong: first,
+	};
+}
diff --git a/src/lain/stats/recorder.ts b/src/lain/stats/recorder.ts
new file mode 100644
index 00000000..9825bf3d
--- /dev/null
+++ b/src/lain/stats/recorder.ts
@@ -0,0 +1,164 @@
+// lain: records plays and vc sessions for the stats commands. postgres only (no-op on sqlite).
+// every write is queued per guild and never throws: logging must not block or crash the player.
+import { randomUUID } from "node:crypto";
+import { and, eq, isNull, sql } from "drizzle-orm";
+import type { Track } from "lavalink-client";
+import { getDatabase } from "../../database/factory";
+import { PostgresProvider } from "../../database/provider";
+import { play, voiceSession } from "../../database/schemas";
+import logger from "../../structures/Logger";
+import { isSkipped, playedMs } from "./rules";
+
+type Db = PostgresProvider["db"];
+type Open = { id: string; startedAt: number; pausedAt: number | null; pausedMs: number; lengthMs: number; isStream: boolean };
+
+export interface Recorder {
+	trackStarted(guildId: string, track: Track, at?: Date): Promise<void>;
+	trackEnded(guildId: string, reason: string, at?: Date): Promise<void>;
+	paused(guildId: string, at?: Date): Promise<void>;
+	resumed(guildId: string, at?: Date): Promise<void>;
+	joined(guildId: string, channelId: string, at?: Date): Promise<void>;
+	left(guildId: string, at?: Date): Promise<void>;
+	closeStale(at?: Date): Promise<void>;
+}
+
+export function recorderFor(db: Db): Recorder {
+	const open = new Map<string, Open>();
+	const queues = new Map<string, Promise<void>>();
+
+	// run fn after the guild's previous write; errors go to the logger, never to the caller.
+	const queue = (guildId: string, fn: () => Promise<unknown>): Promise<void> => {
+		const next = (queues.get(guildId) ?? Promise.resolve())
+			.then(fn)
+			.then(() => {})
+			.catch((e) => logger.error(`[stats] ${e}`));
+		queues.set(guildId, next);
+		return next;
+	};
+
+	const close = async (guildId: string, reason: string, endedAt: number) => {
+		const row = open.get(guildId);
+		if (!row) return;
+		open.delete(guildId);
+		const paused = row.pausedMs + (row.pausedAt === null ? 0 : Math.max(0, endedAt - row.pausedAt));
+		const ms = playedMs(row.startedAt, endedAt, paused, row.lengthMs, row.isStream);
+		await db
+			.update(play)
+			.set({ playedMs: ms, endReason: reason, skipped: isSkipped(reason, ms, row.lengthMs, row.isStream) })
+			.where(eq(play.id, row.id));
+	};
+
+	return {
+		trackStarted(guildId, track, at = new Date()) {
+			return queue(guildId, async () => {
+				await close(guildId, "replaced", at.getTime());
+				const info = track.info;
+				const isStream = Boolean(info.isStream);
+				const lengthMs = isStream ? 0 : Math.max(0, Math.round(info.duration ?? 0));
+				const id = randomUUID();
+				open.set(guildId, { id, startedAt: at.getTime(), pausedAt: null, pausedMs: 0, lengthMs, isStream });
+				await db.insert(play).values({
+					id,
+					guildId,
+					requesterId: (track.requester as { id?: string } | undefined)?.id ?? null,
+					title: info.title ?? "unknown",
+					author: info.author ?? null,
+					uri: info.uri ?? null,
+					source: info.sourceName ?? null,
+					lengthMs,
+					isStream,
+					startedAt: at,
+				});
+			});
+		},
+		trackEnded(guildId, reason, at = new Date()) {
+			return queue(guildId, () => close(guildId, reason, at.getTime()));
+		},
+		paused(guildId, at = new Date()) {
+			return queue(guildId, async () => {
+				const row = open.get(guildId);
+				if (row && row.pausedAt === null) row.pausedAt = at.getTime();
+			});
+		},
+		resumed(guildId, at = new Date()) {
+			return queue(guildId, async () => {
+				const row = open.get(guildId);
+				if (row && row.pausedAt !== null) {
+					row.pausedMs += Math.max(0, at.getTime() - row.pausedAt);
+					row.pausedAt = null;
+				}
+			});
+		},
+		joined(guildId, channelId, at = new Date()) {
+			return queue(guildId, async () => {
+				await db
+					.update(voiceSession)
+					.set({ leftAt: at })
+					.where(and(eq(voiceSession.guildId, guildId), isNull(voiceSession.leftAt)));
+				await db.insert(voiceSession).values({ id: randomUUID(), guildId, channelId, joinedAt: at });
+			});
+		},
+		left(guildId, at = new Date()) {
+			return queue(guildId, async () => {
+				await close(guildId, "destroy", at.getTime());
+				await db
+					.update(voiceSession)
+					.set({ leftAt: at })
+					.where(and(eq(voiceSession.guildId, guildId), isNull(voiceSession.leftAt)));
+			});
+		},
+		// startup repair: rows still open from before this process can no longer be closed by events.
+		// playedMs = time until the next play in that guild (or now), capped at the length; a stream
+		// with no later play gets 0 because its real end is unknown. sessions end at their last play.
+		closeStale(at = new Date()) {
+			return queue("*", async () => {
+				const cutoff = at.toISOString();
+				await db.execute(sql`
+					update "Play" p set
+						"playedMs" = greatest(0, case
+							when p."isStream" or p."lengthMs" <= 0 then
+								case when n.next is null then 0 else extract(epoch from n.next - p."startedAt") * 1000 end
+							else least(p."lengthMs", extract(epoch from coalesce(n.next, ${cutoff}::timestamptz) - p."startedAt") * 1000)
+						end)::int,
+						"endReason" = 'restart',
+						"skipped" = false
+					from (
+						select o.id, (
+							select min(q."startedAt") from "Play" q
+							where q."guildId" = o."guildId" and q."startedAt" > o."startedAt"
+						) as next
+						from "Play" o
+						where o."playedMs" is null and o."startedAt" < ${cutoff}::timestamptz
+					) n
+					where p.id = n.id`);
+				await db.execute(sql`
+					update "VoiceSession" v set "leftAt" = greatest(v."joinedAt", coalesce((
+						select max(p."startedAt" + p."playedMs" * interval '1 millisecond') from "Play" p
+						where p."guildId" = v."guildId" and p."startedAt" >= v."joinedAt" and p."playedMs" is not null
+					), v."joinedAt"))
+					where v."leftAt" is null and v."joinedAt" < ${cutoff}::timestamptz`);
+			});
+		},
+	};
+}
+
+// default recorder: bound lazily to the bot's database, a no-op unless it is postgres.
+// `at` is taken when the event fires, not when the database is ready.
+let recorder: Promise<Recorder | null> | null = null;
+const get = () =>
+	(recorder ??= getDatabase()
+		.then((p) => (p instanceof PostgresProvider ? recorderFor(p.db) : null))
+		.catch((e) => {
+			logger.error(`[stats] ${e}`);
+			return null;
+		}));
+const call = <K extends keyof Recorder>(name: K, ...args: Parameters<Recorder[K]>): Promise<void> =>
+	get().then((r) => (r ? (r[name] as (...a: unknown[]) => Promise<void>)(...args) : undefined));
+
+export const trackStarted = (guildId: string, track: Track, at = new Date()) => void call("trackStarted", guildId, track, at);
+export const trackEnded = (guildId: string, reason: string, at = new Date()) => void call("trackEnded", guildId, reason, at);
+export const paused = (guildId: string, at = new Date()) => void call("paused", guildId, at);
+export const resumed = (guildId: string, at = new Date()) => void call("resumed", guildId, at);
+export const joined = (guildId: string, channelId: string, at = new Date()) => void call("joined", guildId, channelId, at);
+export const left = (guildId: string, at = new Date()) => void call("left", guildId, at);
+export const closeStale = (at = new Date()): Promise<void> => call("closeStale", at);

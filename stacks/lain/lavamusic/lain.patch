+import { Command, type Context, type Lavamusic } from "../../structures/index";
+import { link, lastPlayed, queueAgain } from "../../lain/again";
+import { ReadMessageHistory, SendMessages, ViewChannel } from "../../utils/Permissions";
+
+// lain: "repeat" while a song plays toggles looping it. after the queue ended it
+// plays the last song again and loops it.
+export default class Repeat extends Command {
+	constructor(client: Lavamusic) {
+		super(client, {
+			name: "repeat",
+			description: {
+				content: "loop the current song, or play the last one again on loop",
+				examples: ["repeat"],
+				usage: "repeat",
+			},
+			category: "music",
+			aliases: ["again", "nochmal", "once", "rep"],
+			cooldown: 3,
+			args: false,
+			vote: false,
+			player: { voice: true, dj: false, active: false, djPerm: null },
+			permissions: { dev: false, client: [SendMessages, ReadMessageHistory, ViewChannel], user: [] },
+			slashCommand: false,
+			options: [],
+		});
+	}
+
+	public async run(client: Lavamusic, ctx: Context): Promise<any> {
+		const player = client.manager.getPlayer(ctx.guild.id);
+		if (!player) return await ctx.sendMessage("nothing to repeat. play something first.");
+
+		const current = player.queue.current;
+		if (current) {
+			if (player.repeatMode === "track") {
+				await player.setRepeatMode("off");
+				return await ctx.sendMessage(`stopped looping ${link(current)}.`);
+			}
+			await player.setRepeatMode("track");
+			return await ctx.sendMessage(`looping ${link(current)}. \`lain repeat\` again to stop.`);
+		}
+
+		const last = lastPlayed(player);
+		if (!last) return await ctx.sendMessage("nothing to repeat. play something first.");
+		await player.setRepeatMode("track");
+		await queueAgain(player, last);
+		return await ctx.sendMessage(`again: ${link(last)}, on loop. \`lain repeat\` to stop looping.`);
+	}
+}
